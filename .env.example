# SquadSync Frontend Environment Variables
# The URL pointing to the FastAPI backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# SquadSync Backend Environment Variables (Optional)
# GitHub Personal Access Token (PAT) with repo scope
# Increases GitHub API rate limit from 60 req/hr to 5,000 req/hr and enables private repository access.
# NEVER commit your actual token to GitHub!
GITHUB_TOKEN=
